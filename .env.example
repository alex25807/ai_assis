# Токен ТЕСТОВОГО бота из @BotFather.
# Не используйте токен живого Savvy-бота @narrodnyeoknaa_bot:
# Telegram отдаёт сообщения только одному получателю, Savvy перестанет отвечать.
TELEGRAM_BOT_TOKEN=

# Необязательно: чат менеджера для уведомлений о заявках
MANAGER_CHAT_ID=

# LLM (Qwen / любой OpenAI-совместимый endpoint). Без ключа работает встроенный FAQ.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# local — отдельный SQLite-календарь (по умолчанию, не трогает Savvy).
# google — только если укажете ДРУГОЙ календарь, не календарь продакшен-бота.
CALENDAR_BACKEND=local
SQLITE_PATH=data/assistant.db
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=

TZ_NAME=Asia/Chita
